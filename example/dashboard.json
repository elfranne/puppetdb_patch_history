    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "puppetdb-patch-history" },
      "description": "Oldest patch activity first. Only nodes that changed a package inside the time range appear - an absent node either had nothing to patch or was not patched, and this archive cannot tell those apart. Use PuppetDB's node report_timestamp for that. 'Days ago' is measured from now, not from the end of the range.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": true,
            "inspect": false
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Days ago" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "custom.width", "value": 110 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 45 },
                    { "color": "red", "value": 90 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Package updates" },
            "properties": [{ "id": "custom.width", "value": 150 }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 26 },
      "id": 9,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Days ago" }]
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "puppetdb-patch-history" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.certname    AS \"Node\",\n       max(e.run_at) AS \"Last patched\",\n       floor(extract(epoch FROM now() - max(e.run_at)) / 86400)::int AS \"Days ago\",\n       count(*)      AS \"Package updates\"\nFROM patch_history.patch_event e\nWHERE $__timeFilter(e.run_at)\n  AND e.certname ~ '^(${certname:regex})$'\n  AND e.package  ~ '^(${package:regex})$'\n  AND e.status   ~ '^(${status:regex})$'\nGROUP BY 1\nORDER BY 2 ASC\nLIMIT 500;",
          "refId": "A"
        }
      ],
      "title": "Nodes by last patch",
      "type": "table"
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "puppetdb-patch-history" },
      "description": "Package updates Puppet reported as failed, with the provider's own error text. Identical failures collapse into one row with a count. There is no 'to' version: the attempt never completed, so the only target ever recorded is the catalog's 'latest'. This panel ignores the Status filter deliberately.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": true,
            "inspect": false
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Attempts" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "custom.width", "value": 100 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "text", "value": null },
                    { "color": "red", "value": 3 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Message" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "auto", "wrapText": true } },
              { "id": "custom.minWidth", "value": 260 }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 26 },
      "id": 10,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Last failure" }]
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "puppetdb-patch-history" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.certname    AS \"Node\",\n       e.package     AS \"Package\",\n       e.old_version AS \"From\",\n       e.message     AS \"Message\",\n       count(*)      AS \"Attempts\",\n       max(e.run_at) AS \"Last failure\"\nFROM patch_history.patch_event e\nWHERE $__timeFilter(e.run_at)\n  AND e.certname ~ '^(${certname:regex})$'\n  AND e.package  ~ '^(${package:regex})$'\n  AND e.status = 'failure'\nGROUP BY 1, 2, 3, 4\nORDER BY 6 DESC\nLIMIT 500;",
          "refId": "A"
        }
      ],
      "title": "Failed updates",
      "type": "table"
    },
