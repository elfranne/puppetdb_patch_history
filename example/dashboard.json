      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "puppetdb-patch-history" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.run_at            AS \"Run at\",\n       e.certname          AS \"Node\",\n       e.package           AS \"Package\",\n       e.old_version       AS \"From\",\n       e.effective_version AS \"To\",\n       e.status            AS \"Status\"\nFROM patch_history.patch_event e\nWHERE $__timeFilter(e.run_at)\n  AND e.certname ~ '^(${certname:regex})$'\n  AND e.package  ~ '^(${package:regex})$'\n  AND e.status   ~ '^(${status:regex})$'\nORDER BY e.run_at DESC, e.certname, e.package\nLIMIT 500;",
          "refId": "A"
        }
      ],
      "title": "Patch activity",
      "type": "table"
    }
