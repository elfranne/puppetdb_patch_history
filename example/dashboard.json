      "type": "row"
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "puppetdb-patch-history" },
      "description": "One row per package changed in a run. A package updated on fifty nodes counts fifty times.",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "text", "mode": "fixed" },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "puppetdb-patch-history" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Package updates\"\nFROM patch_history.patch_event e\nWHERE $__timeFilter(e.run_at)\n  AND e.certname ~ '^(${certname:regex})$'\n  AND e.package  ~ '^(${package:regex})$'\n  AND e.status   ~ '^(${status:regex})$';",
          "refId": "A"
        }
      ],
      "title": "Package updates",
      "type": "stat"
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "puppetdb-patch-history" },
      "description": "Distinct certnames that changed at least one package in the range. A node with nothing to patch never appears in this archive at all.",
