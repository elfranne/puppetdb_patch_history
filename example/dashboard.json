    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "puppetdb-patch-history" },
      "description": "The fifteen most frequently updated packages in the range, counted once per node per run.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-blues" },
          "mappings": [],
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 9, "x": 0, "y": 15 },
      "id": 7,
      "options": {
        "displayMode": "basic",
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "left",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": [], "fields": "/^Updates$/", "values": true },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "text"
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "puppetdb-patch-history" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.package AS \"Package\",\n       count(*)  AS \"Updates\"\nFROM patch_history.patch_event e\nWHERE $__timeFilter(e.run_at)\n  AND e.certname ~ '^(${certname:regex})$'\n  AND e.package  ~ '^(${package:regex})$'\n  AND e.status   ~ '^(${status:regex})$'\nGROUP BY 1\nORDER BY 2 DESC\nLIMIT 15;",
          "refId": "A"
