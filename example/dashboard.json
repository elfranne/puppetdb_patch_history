    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "puppetdb-patch-history" },
      "description": "Which version of a package landed where, and when it first and last appeared. The version is effective_version, parsed out of the agent's message - patching_as_code asks for `ensure => latest`, so the catalog value alone would say nothing. Rows still reading 'latest' are excluded: those are events whose message could not be parsed, or which predate the message column. Version strings are stored exactly as reported, so this sorts by time, not by version.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": true,
            "inspect": false
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Nodes" },
            "properties": [{ "id": "custom.width", "value": 90 }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 15, "x": 9, "y": 15 },
      "id": 8,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Last seen" }]
      },
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "puppetdb-patch-history" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.package           AS \"Package\",\n       e.effective_version AS \"Version\",\n       count(DISTINCT e.certname) AS \"Nodes\",\n       min(e.run_at)       AS \"First seen\",\n       max(e.run_at)       AS \"Last seen\"\nFROM patch_history.patch_event e\nWHERE $__timeFilter(e.run_at)\n  AND e.certname ~ '^(${certname:regex})$'\n  AND e.package  ~ '^(${package:regex})$'\n  AND e.status   ~ '^(${status:regex})$'\n  AND e.effective_version IS NOT NULL\n  AND e.effective_version NOT IN ('absent', 'latest')\nGROUP BY 1, 2\nORDER BY 5 DESC\nLIMIT 500;",
          "refId": "A"
        }
      ],
      "title": "Version rollout",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
